# SOURCE help {{{

## for gf-user: <Leader>l -> <C-n/k> -> gf
## `<Leader>l` : Set Search pattern  ($XDG_CONFIG_HOME/nvim/lua/config/scratch.lua)
## `<C-n/k>`   : Search pattern      ($XDG_CONFIG_HOME/nvim/lua/config/keymaps.lua)
## `gf`        : goto file

zsh_add_file() { [ -f "$1" ] && source "$1" }

