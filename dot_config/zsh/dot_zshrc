### add Starship {{{

if [[ -a /usr/local/bin/starship ]]; then
    eval "$(starship init zsh)"
else
    echo "Starship が見つかりません。インストールします..."

    curl -sS https://starship.rs/install.sh | sh

    if command -v starship >/dev/null 2>&1; then
        eval "$(starship init zsh)"
    else
        warn "  FAILED TO INSTALL: Starship"
        echo
    fi
fi

